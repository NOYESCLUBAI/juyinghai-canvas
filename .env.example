# 漫金海环境变量。复制为 .env 后填写。空着的项保持空，不要把真实密钥提交到 git。
# 「公开」会进入浏览器或构建日志；「密钥」只放后端平台的环境变量，不要加 VITE_ 前缀。

# ---------- 公开：前端构建时写入静态站点（Vite 只打包 VITE_ 开头的变量） ----------
# 托管站点设为 true。留空或不是 true 时，前端仍用本机 localStorage / IndexedDB。
VITE_MJH_HOSTED=
# 后端完整源站，不要末尾斜杠。同域反代 /api 时留空。跨域时必须设置，并在后端 MJH_PUBLIC_ORIGINS 里放前端源站。
VITE_API_BASE=
# Supabase 项目 URL 与 publishable key。这两项设计上就是给浏览器的，不是 service role。
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# AGPL 页脚。上线时改成与该次部署一致的源码地址和版本（commit 或 tag）。
VITE_SOURCE_URL=https://github.com/NOYESCLUBAI/manjinhai-canvas
VITE_APP_VERSION=0.1.0

# ---------- 公开：本地开发端口（可写进仓库示例，不含秘密） ----------
MJH_CANVAS_API_TARGET=http://127.0.0.1:3012
MJH_API_PORT=3012
MJH_WEB_PORT=5173

# ---------- 密钥：只放后端。托管模式生成请求不会读取下面的 MJH_*_API_KEY ----------
# 设为 true 才启用 JWT、邀请名单、云端库和按用户计费的限流。本地 npm run dev 不要设。
MJH_HOSTED=
# 逗号分隔的邀请邮箱或 Supabase user id。不支持通配符。也可改用数据库表 public.invite_allowlist。两边都空则全部拒绝。
MJH_INVITE_ALLOWLIST=
# 前端源站，逗号分隔，含协议和端口，例如 https://app.example.com 。跨域时必填。
MJH_PUBLIC_ORIGINS=

# Supabase。SUPABASE_URL 可与 VITE_SUPABASE_URL 相同。JWT 二选一：旧项目用 JWT Secret（HS256），新项目用 JWKS（RS256/ES256）。
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
# 一般保持默认 authenticated。issuer 不填则不校验 iss。
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_ISS=
# Postgres 连接串（Session pooler 或直连）。service role 会绕过 RLS，后端仍按 user_id 过滤。
SUPABASE_DB_URL=
# 与 SUPABASE_DB_URL 二选一，方便托管平台的默认变量名。
DATABASE_URL=
# 只放后端。用于上传私有桶和签发短时 URL。绝不要写成 VITE_。
SUPABASE_SERVICE_ROLE_KEY=

# 加密用户保存的模型密钥。生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 丢失后已保存的密钥无法解密，只能让用户重新填写。
MJH_CONFIG_ENCRYPTION_KEY=
# 可选。内存对象存储的签名密钥。不填则复用上面的加密密钥。Supabase Storage 使用平台自己的签名 URL。
MJH_MEDIA_SIGNING_KEY=
# 私有桶名，须与迁移脚本一致。
MJH_MEDIA_BUCKET=manjinhai-media
# 签名 URL 有效秒数，限制在 30–3600，默认 120。
MJH_SIGNED_URL_SECONDS=120
# 单文件上限字节。默认 47185920（45MB），低于 Supabase Free 的 50MB 上传上限。
MJH_MEDIA_MAX_BYTES=47185920

# 每用户且每 IP、每 60 秒。只作用于 /api/chat、/api/images/generate、/api/videos/generate。
MJH_RATE_TEXT_PER_MINUTE=20
MJH_RATE_IMAGE_PER_MINUTE=8
MJH_RATE_VIDEO_PER_MINUTE=4
# 同一用户排队中加进行中的视频任务上限。
MJH_VIDEO_CONCURRENCY=2
# 后台向 Agnes 轮询的间隔秒数。
MJH_VIDEO_POLL_SECONDS=3
MJH_VIDEO_TIMEOUT_SECONDS=420

# 仅测试。生产必须为 false 或不设置。为 true 时数据只在进程内存里。
MJH_ALLOW_MEMORY_STORE=false

# ---------- 仅本地模式：托管站点的生成请求忽略这些密钥，不会当作公共回退 ----------
MJH_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
MJH_LLM_API_KEY=
MJH_LLM_MODEL=agnes-3.0-flash
MJH_LLM_MODELS=agnes-3.0-flash,agnes-2.5-flash
MJH_LLM_ENABLE_THINKING=false
MJH_LLM_TIMEOUT_SECONDS=75

MJH_IMAGE_PROVIDER=agnes
MJH_IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1
MJH_IMAGE_API_KEY=
MJH_IMAGE_MODEL=agnes-image-2.5-flash
MJH_IMAGE_MODELS=agnes-image-2.5-flash,agnes-image-2.1-flash,agnes-image-2.0-flash
MJH_IMAGE_TIMEOUT_SECONDS=180

MJH_VIDEO_BASE_URL=https://apihub.agnes-ai.com/v1
MJH_VIDEO_QUERY_BASE_URL=https://apihub.agnes-ai.com
MJH_VIDEO_API_KEY=
MJH_VIDEO_MODEL=agnes-video-2.5-flash
MJH_VIDEO_MODELS=agnes-video-2.5-flash
