# 漫金海前端只访问自己的 FastAPI 服务。
MJH_CANVAS_API_TARGET=http://127.0.0.1:3012
MJH_API_PORT=3012

# Agnes AI：密钥只放在后端环境中，不要写进 VITE_ 开头的变量。
MJH_LLM_BASE_URL=https://apihub.agnes-ai.com/v1
MJH_LLM_API_KEY=
MJH_LLM_MODEL=agnes-3.0-flash
MJH_LLM_MODELS=agnes-3.0-flash,agnes-2.5-flash
MJH_LLM_ENABLE_THINKING=false
MJH_LLM_TIMEOUT_SECONDS=75

# 图片生成：前端统一调用 FastAPI，由后端按供应商协议适配。
MJH_IMAGE_PROVIDER=agnes
MJH_IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1
MJH_IMAGE_API_KEY=
MJH_IMAGE_MODEL=agnes-image-2.5-flash
MJH_IMAGE_MODELS=agnes-image-2.5-flash,agnes-image-2.1-flash,agnes-image-2.0-flash
MJH_IMAGE_TIMEOUT_SECONDS=180

# 视频生成：异步创建任务并轮询结果，默认复用 Agnes AI 密钥。
MJH_VIDEO_BASE_URL=https://apihub.agnes-ai.com/v1
MJH_VIDEO_QUERY_BASE_URL=https://apihub.agnes-ai.com
MJH_VIDEO_API_KEY=
MJH_VIDEO_MODEL=agnes-video-2.5-flash
MJH_VIDEO_MODELS=agnes-video-2.5-flash
MJH_VIDEO_TIMEOUT_SECONDS=420

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
