{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE_WITH_RENDER_HOST/api/:path*"
    },
    {
      "source": "/livez",
      "destination": "https://REPLACE_WITH_RENDER_HOST/livez"
    }
  ]
}
